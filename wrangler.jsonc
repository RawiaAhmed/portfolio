{
  // Cloudflare Workers static-assets config.
  //
  // There is no Worker script here: this is a plain static site, so Cloudflare
  // just serves the built files. `directory` points at Vite's build output,
  // which is produced by `npm run build` and is NOT committed to the repo.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths return index.html rather than a 404,
    // so deep links and the in-page anchors keep working.
    "not_found_handling": "single-page-application"
  }
}
